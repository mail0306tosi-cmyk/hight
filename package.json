{
  "name": "hight",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.cjs",
    "check": "node scripts/build.cjs --check",
    "test:rules": "firebase emulators:exec --project demo-hight --only firestore,auth 'node --test tests/firestore.test.cjs'",
    "test:browser": "node tests/geolocation.cjs",
    "test:integration": "firebase emulators:exec --project demo-hight --only firestore,auth 'node tests/firebase-browser.cjs'",
    "test:auth": "firebase emulators:exec --project demo-hight --only auth 'node tests/auth-browser.cjs'",
    "test:ui": "node tests/social-ui.cjs",
    "test:redesign": "node tests/redesign-ui.cjs"
  },
  "dependencies": {
    "firebase": "13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.1",
    "playwright": "1.64.1"
  }
}
